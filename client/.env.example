# Copy to client/.env and fill in real values.
# Only variables prefixed with VITE_ reach the browser, so never put secrets here.

# Cloudinary cloud name for customer and profile photos. Leave empty to disable uploads.
VITE_CLOUDINARY_CLOUD_NAME=
# Unsigned upload preset in your Cloudinary account (default: ml_default)
VITE_CLOUDINARY_UPLOAD_PRESET=
