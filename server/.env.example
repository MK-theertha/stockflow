# Copy to server/.env and fill in real values.

# development or production. In production the session cookie is only sent over https.
NODE_ENV=development

# Port the Express API listens on
PORT=5050

# MongoDB connection string
DB_URI=mongodb://127.0.0.1:27017/stock

# Long random secret for signing session tokens (openssl rand -base64 32)
JWT_SECRET=

# Set to true when deployed behind a proxy or load balancer (Render, Railway, Nginx...)
TRUST_PROXY=false

# Public URL of the React app; Stripe redirects back here after checkout
CLIENT_URL=http://localhost:5173

# Stripe secret key
STRIPE_SECRET_KEY=

# Google Gemini API key for the AI assistant
GOOGLE_API_KEY=
# Optional: Gemini model name
GEMINI_MODEL=gemini-1.5-flash
